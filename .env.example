# ---- AgentCo (copy to .env locally; on Railway set these per service) ----
DATABASE_URL=postgresql://user:pass@host:5432/agentco

# SELECT-only roles on the live apps' Railway Postgres (create them first, see README).
ADSPOT_RO_DATABASE_URL=
SIDADIYA_RO_DATABASE_URL=

# LLM. INTERNAL/CONFIDENTIAL data only ever goes to the paid Gemini API.
LLM_PROVIDER=gemini            # gemini | fake (tests/offline only)
GEMINI_API_KEY=
GEMINI_MODEL_FLASH=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro
# USD per 1M tokens. VERIFY against current Gemini pricing; budgets are computed from these.
GEMINI_PRICE_FLASH_IN=0.30
GEMINI_PRICE_FLASH_OUT=2.50
GEMINI_PRICE_PRO_IN=1.25
GEMINI_PRICE_PRO_OUT=10.0
# Automatic images (optional). Leave GEMINI_IMAGE_MODEL empty to use Google Flow manually instead.
GEMINI_IMAGE_MODEL=
GEMINI_IMAGE_PRICE_USD=0.04    # per image - VERIFY against current pricing
OMNIROUTE_ENABLED=false        # reserved, not built

# Phase 2: Gmail (see docs/gmail-setup.md). Empty => no mail is read or sent.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_LABEL=AgentCo
UNDO_WINDOW_SECONDS=30
# Optional: a role that can UPDATE only a few AdSpot status columns (README). Empty => AgentCo records
# payments itself and tells you to also mark the booking paid in the AdSpot admin panel.
ADSPOT_WRITE_DATABASE_URL=

# YouTube Shorts (docs/youtube.md). One OAuth client, one refresh token PER CHANNEL. Empty => you download the video and upload by hand.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN_ADSPOT=
YOUTUBE_REFRESH_TOKEN_SIDADIYA=
YOUTUBE_MAX_UPLOADS_PER_DAY=5      # each upload costs 1600 of the default 10,000 daily API quota units
YOUTUBE_SYNTHETIC_DISCLOSURE=true  # tell YouTube the video contains AI-generated media
# Optional AI voiceover / automatic clips (official Gemini API, paid). Empty => no AI voice / clips from Google Flow by hand.
GEMINI_TTS_MODEL=
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_PRICE_PER_1K_CHARS_USD=0.02   # VERIFY against current pricing
VEO_MODEL=
VEO_PRICE_PER_SECOND_USD=0.40            # VERIFY: ~$3 per 8 s clip, so raise the Video Producer budget before using it
MAX_VIDEO_MB=100

# Owner login: Google sign-in (allowlisted email) + TOTP
GOOGLE_CLIENT_ID=
OWNER_EMAIL=
SESSION_SECRET=                # long random string: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_TTL_MIN=120
COOKIE_SECURE=true

# Web push (generate: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

UPLOAD_DIR=uploads             # mount a Railway volume here
DEFAULT_AGENT_BUDGET_USD=5
